# 날씨/지오코딩 API의 베이스 URL. 없으면 helper 테스트와 빌드가 실패한다.
API_URL=

# 에러 알림을 받을 Discord 또는 Slack incoming webhook URL.
# 비워두면 알림 없이 서버 로그로만 떨어진다(로컬 개발 기본값).
ERROR_WEBHOOK_URL=

# 에러 이슈 자동화 (선택). 둘 다 있어야 동작하며, 없으면 webhook 알림만 나간다.
# 토큰은 이 저장소의 Issues 쓰기만 가능한 fine-grained PAT를 권장한다.
ERROR_ISSUE_REPO=cbcruk/weather
ERROR_ISSUE_TOKEN=
